<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="OrangeHRM Automation Suite" parallel="tests" thread-count="3">

  <listeners>
    <listener class-name="com.orangehrm.listeners.RetryListener"/>
    <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
  </listeners>

  <test name="Login Tests">
    <classes>
      <class name="com.orangehrm.tests.LoginTests"/>
    </classes>
  </test>

  <test name="PIM Tests">
    <classes>
      <class name="com.orangehrm.tests.EmployeeSearchTests"/>
      <class name="com.orangehrm.tests.AddEmployeeTests"/>
    </classes>
  </test>

  <test name="Admin And UI Tests">
    <classes>
      <class name="com.orangehrm.tests.AdminTests"/>
      <class name="com.orangehrm.tests.UiTests"/>
    </classes>
  </test>

</suite>